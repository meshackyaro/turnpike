# --- Hedera rail -------------------------------------------------------------
# Use ECDSA accounts. x402 works with either key type — the scheme reads the
# type from the mirror node — but ED25519 accounts have no EVM alias and cannot
# touch Hedera smart contracts or the JSON-RPC relay. ECDSA costs nothing here
# and keeps that door open.
#
# Always reference accounts by their 0.0.x ID, never the 0x... EVM alias: the
# scheme's aliasPolicy defaults to "reject" and an alias in payTo is refused.
#
# Testnet account that RECEIVES payments (the seller's treasury).
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=

# Testnet account the BUYER pays from.
HEDERA_BUYER_ACCOUNT_ID=0.0.xxxxx
HEDERA_BUYER_PRIVATE_KEY=

# x402 facilitator with Hedera support. Verifies and settles; also declares
# itself feePayer in the 402, which is why the buyer needs no HBAR for gas.
# The default facilitator advertises hedera:testnet and needs no API key.
# Backup: https://blocky402.com (open access on testnet).
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Arc / Circle rail -------------------------------------------------------
CIRCLE_API_KEY=
ARC_RPC_URL=
ARC_USDC_ADDRESS=
EVM_ADDRESS=

# --- Tricia (orchestrator agent) ---------------------------------------------
ANTHROPIC_API_KEY=

# --- ENS discovery (Sepolia, ENSv2) ------------------------------------------
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=turnpike.eth
