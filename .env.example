# --- Hedera rail -------------------------------------------------------------
# Testnet account that RECEIVES payments (the seller's treasury).
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=

# Testnet account the BUYER pays from.
HEDERA_BUYER_ACCOUNT_ID=0.0.xxxxx
HEDERA_BUYER_PRIVATE_KEY=

# x402 facilitator with Hedera support. Verifies and settles; also acts as
# feePayer, which is why the buyer needs no HBAR for gas.
X402_FACILITATOR_URL=

# --- Arc / Circle rail -------------------------------------------------------
CIRCLE_API_KEY=
ARC_RPC_URL=
ARC_USDC_ADDRESS=
EVM_ADDRESS=

# --- Tricia (orchestrator agent) ---------------------------------------------
ANTHROPIC_API_KEY=

# --- ENS discovery (Sepolia, ENSv2) ------------------------------------------
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=turnpike.eth
