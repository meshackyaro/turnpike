# --- Hedera rail -------------------------------------------------------------
# Use ECDSA accounts. x402 works with either key type — the scheme reads the
# type from the mirror node — but ED25519 accounts have no EVM alias and cannot
# touch Hedera smart contracts or the JSON-RPC relay. ECDSA costs nothing here
# and keeps that door open.
#
# Always reference accounts by their 0.0.x ID, never the 0x... EVM alias: the
# scheme's aliasPolicy defaults to "reject" and an alias in payTo is refused.
#
# Testnet account that RECEIVES payments (the seller's treasury).
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=

# Testnet account the BUYER pays from.
HEDERA_BUYER_ACCOUNT_ID=0.0.xxxxx
HEDERA_BUYER_PRIVATE_KEY=

# x402 facilitator with Hedera support. Verifies and settles; also declares
# itself feePayer in the 402, which is why the buyer needs no HBAR for gas.
# The default facilitator advertises hedera:testnet and needs no API key.
# Backup: https://blocky402.com (open access on testnet).
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Arc / Circle route ------------------------------------------------------
# Two kinds of 0x value below, unrelated to each other:
#   CONTRACT — identifies code on a chain. Same for everyone, has no private key.
#   ACCOUNT  — identifies a wallet, controlled by a private key.
# A price of "4000 of ARC_USDC_ADDRESS" names the unit; the key is the
# authority to move it.

CIRCLE_API_KEY=

# Circle Gateway's testnet facilitator — the one that advertises Arc. Check with
#   curl https://gateway-api-testnet.circle.com/v1/x402/supported | grep 5042002
# The default x402.org facilitator does NOT carry Arc.
CIRCLE_FACILITATOR_URL=https://gateway-api-testnet.circle.com/v1/x402

ARC_NETWORK=eip155:5042002
ARC_RPC_URL=https://5042002.rpc.thirdweb.com

# CONTRACT — USDC on Arc. Not a wallet. Arc denominates gas in USDC too, so
# there is no separate gas token to fund.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ACCOUNT — seller's receiving address.
EVM_ADDRESS=

# ACCOUNT — buyer's signing key. Not a separate key and not "Arc's key": EVM
# private keys are not chain-specific, so an ECDSA Hedera key already derives
# the buyer's address on Arc and every other EVM chain. Reuse
# HEDERA_BUYER_PRIVATE_KEY.
EVM_PRIVATE_KEY=

# --- Tricia (orchestrator agent) ---------------------------------------------
ANTHROPIC_API_KEY=

# --- ENS discovery (Sepolia, ENSv2) ------------------------------------------
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=turnpike.eth
